{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "source.roc",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#headers"
		},
		{
			"include": "#imports"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#definitions"
		},
		{
			"include": "#annotations"
		},
		{
			"include": "#lambdas"
		},
		{
			"include": "#tag-patterns"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#qualified"
		},
		{
			"include": "#calls"
		},
		{
			"include": "#members"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#constructors"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"interpolations": {
			"name": "meta.interpolation.roc",
			"begin": "\\$\\{",
			"end": "\\}",
			"patterns": [
				{
					"include": "#keywords"
				},
				{
					"include": "#operators"
				},
				{
					"include": "#qualified"
				},
				{
					"include": "#calls"
				},
				{
					"include": "#members"
				},
				{
					"include": "#variables"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#constructors"
				},
				{
					"include": "#punctuation"
				}
			]
		},
		"escapes": {
			"name": "constant.character.escape.roc",
			"match": "\\\\\\(u[a-fA-F]{4,6}\\)"
		},
		"numbers": {
			"name": "constant.numeric.roc",
			"match": "\\b(?:0x[0-9a-fA-F_]+\\b|0o[0-7_]+\\b|0b[01_]+\\b|[0-9][0-9_]*(?:\\.(?:U8|I8|U16|I16|U32|I32|U64|I64|U128|I128|F32|F64|Dec))?)"
		},
		"strings": {
			"patterns": [
				{
					"comment": "double-quoted string",
					"name": "string.quoted.double.roc",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"include": "#interpolations"
						},
						{
							"include": "#escapes"
						}
					]
				},
				{
					"comment": "character",
					"name": "string.quoted.single.char.roc",
					"begin": "'",
					"end": "'"
				},
				{
					"begin": "\\\\\\\\",
					"end": "$",
					"name": "string.multiline.roc",
					"patterns": [
						{
							"include": "#interpolations"
						}
					]
				}
			]
		},
		"comments": {
			"match": "(##.*$)|(#.*$)",
			"captures": {
				"1": {
					"name": "comment.line.documentation.roc"
				},
				"2": {
					"name": "comment.line.roc"
				}
			}
		},
		"operators": {
			"match": "(\\|>|\\b(?:or|and)\\b|!=|!|->|=>|>=|<=|>|<|==|:=|\\.\\.\\.?|\\?\\?|::)|(=)|(\\?)|(//|[-+*/%])",
			"captures": {
				"1": {
					"name": "keyword.operator.roc"
				},
				"2": {
					"name": "keyword.operator.assignment.roc"
				},
				"3": {
					"name": "keyword.control.return.roc"
				},
				"4": {
					"name": "keyword.operator.arithmetic.roc"
				}
			}
		},
		"variables": {
			"name": "variable.other.roc",
			"match": "(?<!(?<!\\.)\\.)(?:\\b|\\$)[a-z_][a-z0-9_]*(?:!|\\b)",
			"comment": "Uses a negative lookbehind to exclude a presceding dot (e.g. `.identifier`), but include two presceding dots (e.g. `..identifier`)"
		},
		"keywords": {
			"match": "\\b(?:(True|False)|(if|else|import|as|for|in|return|match|var|while|dbg|expect|where|break|crash))\\b",
			"captures": {
				"1": {
					"name": "constant.language.roc"
				},
				"2": {
					"name": "keyword.control.roc"
				}
			}
		},
		"punctuation": {
			"match": "(,)|(:)|(\\|)|([{}])|([()])|([\\[\\]])|(\\.)",
			"captures": {
				"1": {
					"name": "punctuation.comma.roc"
				},
				"2": {
					"name": "punctuation.colon.roc"
				},
				"3": {
					"name": "punctuation.other.roc"
				},
				"4": {
					"name": "punctuation.brackets.curly.roc"
				},
				"5": {
					"name": "punctuation.brackets.round.roc"
				},
				"6": {
					"name": "punctuation.brackets.square.roc"
				},
				"7": {
					"name": "punctuation.accessor.roc"
				}
			}
		},
		"headers": {
			"patterns": [
				{
					"comment": "app and package headers",
					"begin": "^(app|package)\\b",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.roc"
						}
					},
					"end": "(?<=\\})|^(?=[A-Za-z_])",
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"begin": "\\[",
							"end": "\\]",
							"beginCaptures": {
								"0": {
									"name": "punctuation.brackets.square.roc"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.brackets.square.roc"
								}
							},
							"patterns": [
								{
									"include": "#comments"
								},
								{
									"name": "meta.provided.roc",
									"match": "[a-z_][A-Za-z0-9_]*!?"
								},
								{
									"name": "entity.name.namespace.roc",
									"match": "[A-Z][A-Za-z0-9_]*"
								},
								{
									"include": "#punctuation"
								}
							]
						},
						{
							"begin": "\\{",
							"end": "\\}",
							"beginCaptures": {
								"0": {
									"name": "punctuation.brackets.curly.roc"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.brackets.curly.roc"
								}
							},
							"patterns": [
								{
									"include": "#comments"
								},
								{
									"name": "keyword.control.roc",
									"match": "\\bplatform\\b"
								},
								{
									"name": "meta.package.roc",
									"match": "[a-z_][A-Za-z0-9_]*(?=\\s*:)"
								},
								{
									"name": "meta.package.roc string.quoted.double.roc",
									"match": "\"[^\"]*\""
								},
								{
									"include": "#punctuation"
								}
							]
						}
					]
				},
				{
					"comment": "Platform header clauses",
					"match": "^(?:(platform)(?=\\s*\")|\\s+(requires|exposes|packages|provides|hosted)(?=\\s*[\\[{])|\\s+(targets)(?=:))",
					"captures": {
						"1": {
							"name": "keyword.control.roc"
						},
						"2": {
							"name": "keyword.control.roc"
						},
						"3": {
							"name": "keyword.control.roc"
						}
					}
				}
			]
		},
		"imports": {
			"patterns": [
				{
					"match": "\\b(import)\\s+(?:([a-z_][A-Za-z0-9_]*)(\\.))?([A-Z][A-Za-z0-9_]*)?",
					"captures": {
						"1": {
							"name": "keyword.control.import.roc"
						},
						"2": {
							"name": "entity.name.namespace.roc"
						},
						"3": {
							"name": "punctuation.accessor.roc"
						},
						"4": {
							"name": "entity.name.namespace.roc"
						}
					}
				},
				{
					"begin": "\\b(exposing)\\s*(\\[)",
					"end": "\\]",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.import.roc"
						},
						"2": {
							"name": "punctuation.brackets.square.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.square.roc"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"name": "keyword.control.roc",
							"match": "\\bas\\b"
						},
						{
							"name": "meta.exposed.roc",
							"match": "[A-Za-z_][A-Za-z0-9_]*!?"
						},
						{
							"include": "#punctuation"
						}
					]
				}
			]
		},
		"definitions": {
			"patterns": [
				{
					"match": "^\\s*([A-Z][A-Za-z0-9_]*)(?=\\s*(?::=|::))",
					"captures": {
						"1": {
							"name": "entity.name.type.definition.roc"
						}
					}
				},
				{
					"comment": "Type definition head with type parameters",
					"begin": "^\\s*([A-Z][A-Za-z0-9_]*)(\\()(?=[a-z_, ]*\\)\\s*(?::=|::))",
					"end": "\\)",
					"beginCaptures": {
						"1": {
							"name": "entity.name.type.definition.roc"
						},
						"2": {
							"name": "punctuation.brackets.round.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.round.roc"
						}
					},
					"patterns": [
						{
							"name": "storage.type.parameter.roc",
							"match": "[a-z_][A-Za-z0-9_]*"
						},
						{
							"include": "#punctuation"
						}
					]
				},
				{
					"match": "^\\s*([A-Z][A-Za-z0-9_]*)(?=\\s*\\s+:\\s)",
					"captures": {
						"1": {
							"name": "storage.type.roc"
						}
					}
				},
				{
					"comment": "Type definition head with type parameters",
					"begin": "^\\s*([A-Z][A-Za-z0-9_]*)(\\()(?=[a-z_, ]*\\)\\s*\\s+:\\s)",
					"end": "\\)",
					"beginCaptures": {
						"1": {
							"name": "storage.type.roc"
						},
						"2": {
							"name": "punctuation.brackets.round.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.round.roc"
						}
					},
					"patterns": [
						{
							"name": "storage.type.parameter.roc",
							"match": "[a-z_][A-Za-z0-9_]*"
						},
						{
							"include": "#punctuation"
						}
					]
				},
				{
					"comment": "Function annotation or lambda binding",
					"match": "^\\s*([a-z_][A-Za-z0-9_]*!?)(?=\\s+:\\s.*[-=]>|\\s*=\\s*\\|)",
					"captures": {
						"1": {
							"name": "entity.name.function.roc"
						}
					}
				}
			]
		},
		"annotations": {
			"comment": "Type annotation: from a spaced colon to the end of the line",
			"begin": "(?<=\\s)(?::=|::|:)(?=\\s|$)",
			"end": "$",
			"beginCaptures": {
				"0": {
					"name": "keyword.operator.roc"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#type-expression"
				}
			]
		},
		"type-expression": {
			"patterns": [
				{
					"name": "keyword.control.roc",
					"match": "\\bwhere\\b"
				},
				{
					"name": "keyword.operator.roc",
					"match": "(?<=\\s)(?::=|::|:)(?=\\s|$)|->|=>|\\.\\."
				},
				{
					"name": "storage.type.inferred.roc",
					"match": "\\b_\\b"
				},
				{
					"name": "variable.other.member.roc",
					"match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s+:\\s)"
				},
				{
					"match": "\\b((?:Bool|Box|Decode|Dict|Encode|Hash|Inspect|List|Num|Result|Set|Str))(\\.)(?=[A-Z])",
					"captures": {
						"1": {
							"name": "entity.name.namespace.builtin.roc"
						},
						"2": {
							"name": "punctuation.accessor.roc"
						}
					}
				},
				{
					"match": "\\b([A-Z][A-Za-z0-9_]*)(\\.)(?=[A-Z])",
					"captures": {
						"1": {
							"name": "entity.name.namespace.roc"
						},
						"2": {
							"name": "punctuation.accessor.roc"
						}
					}
				},
				{
					"name": "storage.type.roc",
					"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
				},
				{
					"name": "storage.type.parameter.roc",
					"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
				},
				{
					"include": "#punctuation"
				}
			]
		},
		"lambdas": {
			"comment": "Lambda parameters; the closing bar must be on the same line",
			"begin": "\\|(?=[^|]*\\|)(?!>)",
			"end": "\\||$",
			"beginCaptures": {
				"0": {
					"name": "punctuation.other.roc"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.other.roc"
				}
			},
			"patterns": [
				{
					"begin": "\\{",
					"end": "\\}",
					"beginCaptures": {
						"0": {
							"name": "punctuation.brackets.curly.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.curly.roc"
						}
					},
					"patterns": [
						{
							"name": "variable.other.member.roc",
							"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
						},
						{
							"include": "#numbers"
						},
						{
							"include": "#constructors"
						},
						{
							"include": "#punctuation"
						},
						{
							"include": "#strings"
						}
					]
				},
				{
					"name": "keyword.operator.roc",
					"match": "\\.\\."
				},
				{
					"name": "keyword.control.roc",
					"match": "\\bas\\b"
				},
				{
					"name": "variable.parameter.roc",
					"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#constructors"
				},
				{
					"include": "#punctuation"
				},
				{
					"include": "#strings"
				}
			]
		},
		"tag-patterns": {
			"comment": "Tag payload pattern at the start of a match branch",
			"begin": "^\\s*([A-Z][A-Za-z0-9_]*)(\\()(?=.*=>)",
			"end": "\\)",
			"beginCaptures": {
				"1": {
					"name": "entity.name.type.constructor.roc"
				},
				"2": {
					"name": "punctuation.brackets.round.roc"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.brackets.round.roc"
				}
			},
			"patterns": [
				{
					"include": "#tag-payload"
				},
				{
					"begin": "\\{",
					"end": "\\}",
					"beginCaptures": {
						"0": {
							"name": "punctuation.brackets.curly.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.curly.roc"
						}
					},
					"patterns": [
						{
							"name": "variable.other.member.roc",
							"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
						},
						{
							"include": "#numbers"
						},
						{
							"include": "#constructors"
						},
						{
							"include": "#punctuation"
						},
						{
							"include": "#strings"
						}
					]
				},
				{
					"name": "keyword.operator.roc",
					"match": "\\.\\."
				},
				{
					"name": "keyword.control.roc",
					"match": "\\bas\\b"
				},
				{
					"name": "variable.parameter.roc",
					"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#constructors"
				},
				{
					"include": "#punctuation"
				},
				{
					"include": "#strings"
				}
			]
		},
		"tag-payload": {
			"begin": "\\b([A-Z][A-Za-z0-9_]*)(\\()",
			"end": "\\)",
			"beginCaptures": {
				"1": {
					"name": "entity.name.type.constructor.roc"
				},
				"2": {
					"name": "punctuation.brackets.round.roc"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.brackets.round.roc"
				}
			},
			"patterns": [
				{
					"include": "#tag-payload"
				},
				{
					"begin": "\\{",
					"end": "\\}",
					"beginCaptures": {
						"0": {
							"name": "punctuation.brackets.curly.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.curly.roc"
						}
					},
					"patterns": [
						{
							"name": "variable.other.member.roc",
							"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
						},
						{
							"include": "#numbers"
						},
						{
							"include": "#constructors"
						},
						{
							"include": "#punctuation"
						},
						{
							"include": "#strings"
						}
					]
				},
				{
					"name": "keyword.operator.roc",
					"match": "\\.\\."
				},
				{
					"name": "keyword.control.roc",
					"match": "\\bas\\b"
				},
				{
					"name": "variable.parameter.roc",
					"match": "\\b[a-z_][A-Za-z0-9_]*\\b"
				},
				{
					"include": "#numbers"
				},
				{
					"include": "#constructors"
				},
				{
					"include": "#punctuation"
				},
				{
					"include": "#strings"
				}
			]
		},
		"qualified": {
			"patterns": [
				{
					"name": "storage.type.roc",
					"match": "\\.(?<=\\}\\.)[A-Z][A-Za-z0-9_]*",
					"comment": "Record builder suffix"
				},
				{
					"comment": "Namespace qualifier, optionally followed by a pure call",
					"match": "\\b(?:((?:Bool|Box|Decode|Dict|Encode|Hash|Inspect|List|Num|Result|Set|Str))|([A-Z][A-Za-z0-9_]*))(\\.)(?:([a-z_][A-Za-z0-9_]*)(?=\\()|(?=[A-Za-z_]))",
					"captures": {
						"1": {
							"name": "entity.name.namespace.builtin.roc"
						},
						"2": {
							"name": "entity.name.namespace.roc"
						},
						"3": {
							"name": "punctuation.accessor.roc"
						},
						"4": {
							"name": "entity.name.function.method.roc"
						}
					}
				}
			]
		},
		"calls": {
			"name": "entity.name.function.roc",
			"match": "\\b[a-z_][A-Za-z0-9_]*(?:!|(?=\\())"
		},
		"members": {
			"patterns": [
				{
					"name": "variable.other.member.roc",
					"match": "(?<=[a-z0-9_)\\]?]\\.)[a-z_][A-Za-z0-9_]*\\b",
					"comment": "Field access"
				},
				{
					"name": "variable.other.member.roc",
					"match": "(?<=[{,]\\s|\\{)[a-z_][A-Za-z0-9_]*\\b(?=(?:\\s*,\\s*[a-z_][A-Za-z0-9_]*)*\\s*\\})",
					"comment": "Record field shorthand"
				},
				{
					"name": "variable.other.member.roc",
					"match": "\\b[a-z_][A-Za-z0-9_]*(?=:(?!:))",
					"comment": "Record field name"
				}
			]
		},
		"constructors": {
			"name": "entity.name.type.constructor.roc",
			"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
		}
	}
}

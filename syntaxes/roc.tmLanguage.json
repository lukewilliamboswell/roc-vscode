{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "source.roc",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#headers"
		},
		{
			"include": "#imports"
		},
		{
			"include": "#match-patterns"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#definitions"
		},
		{
			"include": "#annotations"
		},
		{
			"include": "#lambdas"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#qualified"
		},
		{
			"include": "#members"
		},
		{
			"include": "#calls"
		},
		{
			"include": "#wildcard"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#constructors"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#strings"
		}
	],
	"repository": {
		"interpolations": {
			"name": "meta.interpolation.roc",
			"begin": "\\$\\{",
			"end": "\\}",
			"patterns": [
				{
					"include": "#interpolated-code"
				}
			],
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.interpolation.roc"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.interpolation.roc"
				}
			}
		},
		"escapes": {
			"name": "constant.character.escape.roc",
			"match": "\\\\(?:[\\\\\\\"'nrt$]|u\\([0-9a-fA-F]{1,8}\\))"
		},
		"numbers": {
			"comment": "A minus sign directly before a digit, and not directly after a value, is part of the literal",
			"match": "((?:-(?<![A-Za-z0-9_)\\]}]-))?\\b(?<!\\.)(?:[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][-+]?[0-9]+)?(?:\\.[A-Z][A-Za-z0-9_]*)?|[0-9][0-9_]*[eE][-+]?[0-9]+|[0-9][0-9_]*\\.(?:F32|F64|Dec)))|((?:-(?<![A-Za-z0-9_)\\]}]-))?\\b(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*)(?:\\.[A-Z][A-Za-z0-9_]*)?)",
			"captures": {
				"1": {
					"name": "constant.numeric.float.roc"
				},
				"2": {
					"name": "constant.numeric.integer.roc"
				}
			}
		},
		"strings": {
			"patterns": [
				{
					"comment": "double-quoted string",
					"name": "string.quoted.double.roc",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"include": "#interpolations"
						},
						{
							"include": "#escapes"
						}
					]
				},
				{
					"comment": "character",
					"match": "'(?:[^'\\\\]|(\\\\(?:[\\\\\\\"'nrt$]|u\\([0-9a-fA-F]{1,8}\\))))'",
					"name": "string.quoted.single.char.roc",
					"captures": {
						"1": {
							"name": "constant.character.escape.roc"
						}
					}
				},
				{
					"begin": "\\\\\\\\",
					"end": "$",
					"name": "string.multiline.roc",
					"patterns": [
						{
							"include": "#interpolations"
						},
						{
							"include": "#escapes"
						}
					]
				}
			]
		},
		"comments": {
			"match": "(##.*$)|(#.*$)",
			"captures": {
				"1": {
					"name": "comment.line.documentation.roc"
				},
				"2": {
					"name": "comment.line.roc"
				}
			}
		},
		"operators": {
			"match": "(\\|>|\\b(?:or|and)\\b|!=|!|->|=>|>=|<=|>|<|==|:=|\\.\\.[=<]|\\.\\.\\.?|\\?\\?|::)|(=)|(\\?)|(//|[-+*/%])",
			"captures": {
				"1": {
					"name": "keyword.operator.roc"
				},
				"2": {
					"name": "keyword.operator.assignment.roc"
				},
				"3": {
					"name": "keyword.control.return.roc"
				},
				"4": {
					"name": "keyword.operator.arithmetic.roc"
				}
			}
		},
		"variables": {
			"name": "variable.other.roc",
			"match": "(?<!(?<!\\.)\\.)(?:\\b|\\$)[a-z_][A-Za-z0-9_]*(?:!|\\b)",
			"comment": "Uses a negative lookbehind to exclude a presceding dot (e.g. `.identifier`), but include two presceding dots (e.g. `..identifier`)"
		},
		"keywords": {
			"match": "\\b(?:(True|False)|(if|else|match)|(for|while)|(return)|(import|as|in|var|dbg|expect|where|break|crash))\\b",
			"captures": {
				"1": {
					"name": "constant.language.roc"
				},
				"2": {
					"name": "keyword.control.conditional.roc"
				},
				"3": {
					"name": "keyword.control.repeat.roc"
				},
				"4": {
					"name": "keyword.control.return.roc"
				},
				"5": {
					"name": "keyword.control.roc"
				}
			}
		},
		"punctuation": {
			"match": "(,)|(:)|(\\|)|([{}]|\\.(?=\\{))|([()])|([\\[\\]])|(\\.)",
			"captures": {
				"1": {
					"name": "punctuation.comma.roc"
				},
				"2": {
					"name": "punctuation.colon.roc"
				},
				"3": {
					"name": "punctuation.other.roc"
				},
				"4": {
					"name": "punctuation.brackets.curly.roc"
				},
				"5": {
					"name": "punctuation.brackets.round.roc"
				},
				"6": {
					"name": "punctuation.brackets.square.roc"
				},
				"7": {
					"name": "keyword.operator.accessor.roc"
				}
			}
		},
		"headers": {
			"patterns": [
				{
					"comment": "app header",
					"begin": "^(app)\\b",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.roc"
						}
					},
					"end": "(?<=\\})|^(?=[A-Za-z_])",
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"begin": "\\[",
							"end": "\\]",
							"beginCaptures": {
								"0": {
									"name": "punctuation.brackets.square.roc"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.brackets.square.roc"
								}
							},
							"patterns": [
								{
									"include": "#comments"
								},
								{
									"name": "meta.provided.roc",
									"match": "[a-z_][A-Za-z0-9_]*!?"
								},
								{
									"name": "storage.type.roc",
									"match": "[A-Z][A-Za-z0-9_]*"
								},
								{
									"include": "#punctuation"
								}
							]
						},
						{
							"begin": "\\{",
							"end": "\\}",
							"beginCaptures": {
								"0": {
									"name": "punctuation.brackets.curly.roc"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.brackets.curly.roc"
								}
							},
							"patterns": [
								{
									"include": "#comments"
								},
								{
									"comment": "Only the platform's location is a package scope",
									"match": "\\b(platform)\\s+(\\\"[^\\\"]*\\\")",
									"captures": {
										"1": {
											"name": "keyword.control.roc"
										},
										"2": {
											"name": "string.quoted.double.roc meta.package.roc"
										}
									}
								},
								{
									"name": "keyword.control.roc",
									"match": "\\bplatform\\b"
								},
								{
									"comment": "The platform's package alias",
									"name": "meta.package.roc",
									"match": "[a-z_][A-Za-z0-9_]*(?=\\s*:\\s*platform\\b)"
								},
								{
									"name": "variable.other.roc",
									"match": "[a-z_][A-Za-z0-9_]*(?=\\s*:)"
								},
								{
									"include": "#strings"
								},
								{
									"include": "#punctuation"
								}
							]
						}
					]
				},
				{
					"comment": "package header: dependencies are plain strings",
					"begin": "^(package)\\b",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.roc"
						}
					},
					"end": "(?<=\\})|^(?=[A-Za-z_])",
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"begin": "\\[",
							"end": "\\]",
							"beginCaptures": {
								"0": {
									"name": "punctuation.brackets.square.roc"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.brackets.square.roc"
								}
							},
							"patterns": [
								{
									"include": "#comments"
								},
								{
									"name": "meta.provided.roc",
									"match": "[a-z_][A-Za-z0-9_]*!?"
								},
								{
									"name": "storage.type.roc",
									"match": "[A-Z][A-Za-z0-9_]*"
								},
								{
									"include": "#punctuation"
								}
							]
						},
						{
							"begin": "\\{",
							"end": "\\}",
							"beginCaptures": {
								"0": {
									"name": "punctuation.brackets.curly.roc"
								}
							},
							"endCaptures": {
								"0": {
									"name": "punctuation.brackets.curly.roc"
								}
							},
							"patterns": [
								{
									"include": "#comments"
								},
								{
									"name": "variable.other.roc",
									"match": "[a-z_][A-Za-z0-9_]*(?=\\s*:)"
								},
								{
									"include": "#strings"
								},
								{
									"include": "#punctuation"
								}
							]
						}
					]
				},
				{
					"comment": "Modules exposed by a platform",
					"begin": "^\\s+(exposes)\\s*(\\[)",
					"end": "\\]",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.roc"
						},
						"2": {
							"name": "punctuation.brackets.square.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.square.roc"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"name": "storage.type.roc",
							"match": "[A-Z][A-Za-z0-9_]*"
						},
						{
							"include": "#punctuation"
						}
					]
				},
				{
					"comment": "Platform header clauses",
					"match": "^(?:(platform)(?=\\s*\")|\\s+(requires|exposes|packages|provides|hosted)(?=\\s*[\\[{])|\\s+(targets)(?=:))",
					"captures": {
						"1": {
							"name": "keyword.control.roc"
						},
						"2": {
							"name": "keyword.control.roc"
						},
						"3": {
							"name": "keyword.control.roc"
						}
					}
				}
			]
		},
		"imports": {
			"patterns": [
				{
					"comment": "Import target: `/` traverses directories, `.` selects a package or a nested type, `as` names the imported type",
					"begin": "\\b(import)\\b",
					"end": "$|(?=\"|\\bexposing\\b)",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.import.roc"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"match": "\\b(as)\\s+([A-Z][A-Za-z0-9_]*)",
							"captures": {
								"1": {
									"name": "keyword.control.roc"
								},
								"2": {
									"name": "storage.type.roc"
								}
							}
						},
						{
							"match": "([a-z_][A-Za-z0-9_]*)(?=\\.)|((?:\\.\\.?/)+|/)|(\\.)|([A-Z][A-Za-z0-9_]*)",
							"captures": {
								"1": {
									"name": "variable.other.roc"
								},
								"2": {
									"name": "punctuation.separator.path.roc"
								},
								"3": {
									"name": "keyword.operator.accessor.roc"
								},
								"4": {
									"name": "storage.type.roc"
								}
							}
						}
					]
				},
				{
					"begin": "\\b(exposing)\\s*(\\[)",
					"end": "\\]",
					"beginCaptures": {
						"1": {
							"name": "keyword.control.import.roc"
						},
						"2": {
							"name": "punctuation.brackets.square.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.square.roc"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"name": "keyword.control.roc",
							"match": "\\bas\\b"
						},
						{
							"match": "([A-Z][A-Za-z0-9_]*)|([a-z_][A-Za-z0-9_]*!?)",
							"captures": {
								"1": {
									"name": "meta.exposed.roc storage.type.roc"
								},
								"2": {
									"name": "meta.exposed.roc entity.name.function.roc"
								}
							}
						},
						{
							"include": "#punctuation"
						}
					]
				}
			]
		},
		"definitions": {
			"patterns": [
				{
					"comment": "Nominal type (:= or ::) or type alias (:) definition",
					"begin": "^\\s*(?:([A-Z][A-Za-z0-9_]*)\\s*(:=|::)|([A-Z][A-Za-z0-9_]*)\\s+(:))(?=\\s|$)",
					"end": "$|(?=\\.\\{)",
					"beginCaptures": {
						"1": {
							"name": "entity.name.type.definition.roc"
						},
						"2": {
							"name": "keyword.operator.roc"
						},
						"3": {
							"name": "storage.type.roc"
						},
						"4": {
							"name": "keyword.operator.roc"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#type-expression"
						}
					]
				},
				{
					"comment": "Type definition head with type parameters",
					"begin": "^\\s*(?:([A-Z][A-Za-z0-9_]*)(\\()(?=[a-z_, ]*\\)\\s*(?::=|::))|([A-Z][A-Za-z0-9_]*)(\\()(?=[a-z_, ]*\\)\\s+:\\s))",
					"end": "\\)",
					"beginCaptures": {
						"1": {
							"name": "entity.name.type.definition.roc"
						},
						"2": {
							"name": "punctuation.brackets.round.roc"
						},
						"3": {
							"name": "storage.type.roc"
						},
						"4": {
							"name": "punctuation.brackets.round.roc"
						}
					},
					"endCaptures": {
						"0": {
							"name": "punctuation.brackets.round.roc"
						}
					},
					"patterns": [
						{
							"name": "storage.type.parameter.roc",
							"match": "[a-z_][A-Za-z0-9_]*"
						},
						{
							"include": "#punctuation"
						}
					]
				},
				{
					"comment": "Definition operator after type parameters",
					"begin": ":(?<=\\)\\s:)[:=]?(?=\\s|$)|:[:=](?<=\\):[:=])(?=\\s|$)",
					"end": "$|(?=\\.\\{)",
					"beginCaptures": {
						"0": {
							"name": "keyword.operator.roc"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#type-expression"
						}
					]
				},
				{
					"comment": "Function annotation or lambda binding",
					"match": "^\\s*([a-z_][A-Za-z0-9_]*!?)(?=\\s+:\\s.*[-=]>|\\s*=\\s*\\|)",
					"captures": {
						"1": {
							"name": "entity.name.function.roc"
						}
					}
				}
			]
		},
		"annotations": {
			"comment": "Type annotation: from a spaced colon to the end of the line, or to the method block of a nominal type. Bracketed types may continue over several lines.",
			"begin": ":(?<=\\s:)[:=]?(?=\\s|$)",
			"end": "$|(?=\\.\\{)",
			"beginCaptures": {
				"0": {
					"name": "punctuation.colon.roc"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#type-expression"
				}
			]
		},
		"type-expression": {
			"comment": "A type; commas at this level separate function arguments, record fields or tuple elements",
			"patterns": [
				{
					"include": "#type-atoms"
				},
				{
					"name": "punctuation.comma.type.roc",
					"match": ","
				},
				{
					"include": "#punctuation"
				}
			]
		},
		"lambdas": {
			"comment": "Lambda parameters; the closing bar must be on the same line",
			"begin": "\\|(?=[^|]*\\|)(?!>)",
			"end": "\\||$",
			"beginCaptures": {
				"0": {
					"name": "punctuation.other.roc"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.other.roc"
				}
			},
			"patterns": [
				{
					"include": "#binders"
				}
			]
		},
		"tag-payload": {
			"begin": "\\b([A-Z][A-Za-z0-9_]*)(\\()",
			"end": "\\)",
			"beginCaptures": {
				"1": {
					"name": "entity.name.type.constructor.roc"
				},
				"2": {
					"name": "punctuation.brackets.round.roc"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.brackets.round.roc"
				}
			},
			"patterns": [
				{
					"include": "#binders"
				}
			]
		},
		"qualified": {
			"patterns": [
				{
					"name": "storage.type.roc",
					"match": "\\.(?<=\\}\\.)[A-Z][A-Za-z0-9_]*",
					"comment": "Record builder suffix"
				},
				{
					"comment": "Namespace qualifier, optionally followed by a pure call",
					"match": "\\b(?:((?:Bool|Box|Decode|Dict|Encode|Hash|Inspect|List|Num|Result|Set|Str))|([A-Z][A-Za-z0-9_]*))(\\.)(?:([a-z_][A-Za-z0-9_]*)(?=\\()|(?=[A-Za-z_]))",
					"captures": {
						"1": {
							"name": "storage.type.builtin.roc"
						},
						"2": {
							"name": "storage.type.roc"
						},
						"3": {
							"name": "keyword.operator.accessor.roc"
						},
						"4": {
							"name": "entity.name.function.roc"
						}
					}
				}
			]
		},
		"calls": {
			"comment": "Call, method call or effectful function reference",
			"name": "entity.name.function.roc",
			"match": "\\b[a-z_][A-Za-z0-9_]*(?:!(?!:)|(?=\\())"
		},
		"members": {
			"comment": "Field access, record field shorthand, or record field name. `{ x }` is a block, so shorthand needs a comma",
			"name": "variable.other.member.roc",
			"match": "(?<=[a-z0-9_)\\]?]\\.)[a-z_][A-Za-z0-9_]*\\b(?!!|\\()|(?<=\\{\\s|\\{)(?<!\\$\\{)[a-z_][A-Za-z0-9_]*!?(?=(?:\\s*,\\s*[a-z_][A-Za-z0-9_]*!?)+\\s*\\})|(?<=,\\s)[a-z_][A-Za-z0-9_]*!?(?=(?:\\s*,\\s*[a-z_][A-Za-z0-9_]*!?)*\\s*\\})|(?<=\\{\\s)(?<!\\$\\{\\s)[a-z_][A-Za-z0-9_]*!?(?=\\s*,)|\\b[a-z_][A-Za-z0-9_]*!?(?=:(?!:))"
		},
		"constructors": {
			"name": "entity.name.type.constructor.roc",
			"match": "\\b[A-Z][A-Za-z0-9_]*\\b"
		},
		"tag-union-type": {
			"begin": "\\[",
			"end": "\\]",
			"beginCaptures": {
				"0": {
					"name": "punctuation.brackets.square.type.roc"
				}
			},
			"endCaptures": {
				"0": {
					"name": "punctuation.brackets.square.type.roc"
				}
			},
			"patterns": [
				{
					"include": "#comments"
				},
				{
					"include": "#tag-union-type"
				},
				{
					"comment": "Tag payload",
					"begin": "\\(",
					"end": "\\)",
					"beginCaptures": {
						"0": {
							"name": "punctuation.brackets.round.roc"
						}
					},
					"endCaptures": {
						"0": {
